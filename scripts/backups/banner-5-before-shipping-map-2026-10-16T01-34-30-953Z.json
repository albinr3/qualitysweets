\n      }\n    });\n\n    if (window.jQuery && typeof window.jQuery.fn.superfish === 'function') {\n      try { window.jQuery('ul.sf-menu').superfish(); } catch (e) {}\n    }\n  }\n\n  if (!document.getElementById('qs-header-takeout-style')) {\n    var style = document.createElement('style');\n    style.id = 'qs-header-takeout-style';\n    style.textContent = [\n      '#Header .PageMenu ul.sf-horizontal > li.qs-nav-takeout { flex: 0 1 auto !important; white-space: nowrap !important; }',\n      '#Header .PageMenu ul.sf-horizontal > li.qs-nav-takeout > a { font-weight: 700 !important; }',\n      '#Header .PageMenu ul.sf-horizontal > li.qs-nav-takeout:hover > ul { display: block !important; }',\n      '#Header .PageMenu ul.sf-horizontal > li.qs-nav-takeout ul { min-width: 220px !important; }',\n      '@media screen and (min-width: 1101px) {',\n      '  #Header .PageMenu #SideCategoryList > .BlockContent > .SideCategoryListFlyout > ul > li > a { font-size: 14.5px !important; padding: 12px 7px !important; }',\n      '}'\n    ].join('\\n');\n    document.head.appendChild(style);\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', injectTakeoutMenu, { once: true });\n  } else {\n    injectTakeoutMenu();\n  }\n  window.addEventListener('load', injectTakeoutMenu, { once: true });\n})();\n</script>\n\n<script id=\"qs-home-images-seo\">\n(function () {\n  function optimizeHomeImages() {\n    // 1. Logo\n    var logo = document.getElementById('LogoImage') || document.querySelector('img[src*=\"qs2021-01\"]');\n    if (logo) {\n      logo.alt = 'Quality Sweets Indian Sweets and Snacks';\n      logo.setAttribute('width', '160');\n      logo.setAttribute('height', '165');\n      logo.setAttribute('fetchpriority', 'high');\n    }\n\n    // 2. Theme Slideshow Carousel Images\n    var slides = document.querySelectorAll('.slide-show img, .slide-image, img[src*=\"theme_images\"]');\n    slides.forEach(function (img) {\n      var src = img.getAttribute('src') || '';\n      if (src.indexOf('gift_basket') !== -1) {\n        img.alt = 'Assorted sweets gift baskets and festival hampers';\n        img.setAttribute('title', 'Festive Mithai Gift Baskets');\n        img.setAttribute('loading', 'lazy');\n        img.setAttribute('decoding', 'async');\n      } else if (src.indexOf('QS_banner') !== -1) {\n        img.alt = 'Fresh Indian mithai and snacks made daily';\n        img.setAttribute('title', 'Handcrafted Indian Sweets Daily');\n        img.setAttribute('loading', 'lazy');\n        img.setAttribute('decoding', 'async');\n      } else if (src.indexOf('bulk_orders') !== -1) {\n        img.alt = 'Bulk pricing on Indian sweets and catering orders';\n        img.setAttribute('title', 'Bulk Mithai and Catering Orders');\n        img.setAttribute('loading', 'lazy');\n        img.setAttribute('decoding', 'async');\n      }\n    });\n\n    // 3. Decorative Blueprint rating star icons (WCAG / SEO Accessibility)\n    var ratings = document.querySelectorAll('img[src*=\"IcoRating\"]');\n    ratings.forEach(function (img) {\n      if (!img.getAttribute('alt')) {\n        img.setAttribute('alt', 'Customer Rating');\n        img.setAttribute('role', 'presentation');\n      }\n    });\n\n    // 4. Loader gif/png (decorative)\n    var loaders = document.querySelectorAll('img[src*=\"loader.png\"]');\n    loaders.forEach(function (img) {\n      if (!img.getAttribute('alt')) {\n        img.setAttribute('alt', '');\n        img.setAttribute('role', 'presentation');\n      }\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', optimizeHomeImages, { once: true });\n  } else {\n    optimizeHomeImages();\n  }\n  window.addEventListener('load', optimizeHomeImages, { once: true });\n})();\n</script>\n",
