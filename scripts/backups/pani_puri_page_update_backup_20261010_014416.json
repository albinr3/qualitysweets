ine);\n  border-radius: 8px;\n  padding: 20px 24px;\n  margin: 40px 0;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n}\n.qs-cross-sell-text {\n  max-width: 780px;\n}\n.qs-cross-sell-text strong {\n  color: var(--wine);\n  display: block;\n  margin-bottom: 4px;\n}\n.qs-cross-sell-text p {\n  margin: 0;\n  font-size: 0.94rem;\n  color: var(--muted);\n}\n\n/* FAQ Accordion */\n.qs-faq details {\n  background: #ffffff;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  margin-bottom: 12px;\n  padding: 16px 20px;\n}\n.qs-faq summary {\n  color: var(--wine-dark);\n  font-family: 'Marcellus', Georgia, serif;\n  font-weight: 700;\n  font-size: 1.08rem;\n  cursor: pointer;\n  outline: none;\n}\n.qs-faq p {\n  margin: 12px 0 0;\n  font-size: 0.95rem;\n  color: var(--muted);\n}\n\n/* Cluster Internal Linking */\n.qs-cluster-nav {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-top: 14px;\n}\n.qs-cluster-nav a {\n  background: #fdfaf5;\n  border: 1px solid var(--border);\n  color: var(--wine) !important;\n  padding: 8px 14px;\n  border-radius: 6px;\n  font-size: 0.9rem;\n  font-weight: 600;\n  text-decoration: none !important;\n}\n.qs-cluster-nav a:hover {\n  background: var(--gold-light);\n  border-color: var(--gold);\n}\n\n@media (max-width: 800px) {\n  .qs-pickup-layout {\n    grid-template-columns: 1fr;\n  }\n}\n</style>\n\n<main class=\"qs-pani-puri\">\n\n  <!-- Breadcrumbs -->\n  <nav class=\"qs-breadcrumbs\" aria-label=\"Breadcrumbs\">\n    <a href=\"/\">Home</a> &raquo; <a href=\"/menu/\">Takeout Menu</a> &raquo; Pani Puri Kits\n  </nav>\n\n  <!-- Strict Operational Warning Notice -->\n  <aside class=\"qs-alert-notice\" role=\"alert\">\n    <div class=\"qs-alert-title\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/></svg>\n      <span>Walk-In Takeout &amp; Counter Pickup Only (No Dine-In Seating)</span>\n    </div>\n    <p>\n      Prepared fresh daily at <strong>1384 Oak Tree Rd, Iselin, NJ 08830</strong>. To make sure your puris stay crunchy, we pack all components separately in spill-proof takeout kits. Hot and chilled chaats are made for counter pickup and are <strong>NOT available for postal mail delivery</strong>. Call ahead at <strong>(732) 283-3799</strong> to have your kit boxed and chilled when you pull up.\n    </p>\n  </aside>\n\n  <!-- Hero Section with Primary H1 -->\n  <header class=\"qs-hero\">\n    <div class=\"qs-eyebrow\">\n      <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z\"/><path d=\"M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12\"/></svg>\n      <span>Oak Tree Road &bull; Iselin, New Jersey &bull; Fresh Chaat Counter Since 2003</span>\n    </div>\n\n    <h1>Crisp Pani Puri &amp; Gol Gappe To-Go: Iselin, NJ Takeout Kits &amp; Party Packs</h1>\n\n    <p class=\"qs-hero-intro\">\n      Thin, golden semolina puris packed with stone-ground mint water, sweet date-tamarind chutney, and spiced potato-chana filling. Packed in spill-proof DIY kits so your puris stay shatteringly crisp until you poke and pour at home.\n    </p>\n\n    <div class=\"qs-actions\">\n      <a class=\"qs-btn qs-btn--gold\" href=\"tel:+17322833799\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.