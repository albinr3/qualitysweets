4af37\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>\n      <span>Packed Cold in Spill-Proof Kits</span>\n    </div>\n  </section>\n\n  <!-- Real Photography Grid -->\n  <section class=\"qs-photo-grid\" aria-label=\"Fresh pani puri photography\">\n    <article class=\"qs-photo-card\">\n      <img src=\"https://cdn10.bigcommerce.com/s-2ygwtj/products/176/images/399/pani_puri_photo_1789098074946__46127.1789098262.1280.1280.jpg?c=2\" alt=\"Crispy Pani Puri kits to-go with flavored mint and tamarind water at Quality Sweets Iselin\" width=\"700\" height=\"460\" fetchpriority=\"high\">\n      <div class=\"qs-photo-caption\">\n        <strong class=\"qs-caption-title\">Crisp Puris with Chilled Mint &amp; Tamarind Waters ($8.00)</strong>\n        <p>Eight puffed puris packed with spiced potato-chana filling, chilled mint water, and date-tamarind chutney.</p>\n      </div>\n    </article>\n\n    <article class=\"qs-photo-card\">\n      <img src=\"https://cdn10.bigcommerce.com/s-2ygwtj/products/176/images/409/samosa-chaat-menu-hero__27274.1789244397.1280.1280.jpg?c=2\" alt=\"Authentic Indian street chaat selection at Quality Sweets on Oak Tree Road\" width=\"700\" height=\"460\" loading=\"lazy\">\n      <div class=\"qs-photo-caption\">\n        <strong class=\"qs-caption-title\">Full Oak Tree Road Chaat Counter</strong>\n        <p>Pair your pani puri kits with our samosa chaat, dahi puri, and freshly fried savory street snacks.</p>\n      </div>\n    </article>\n  </section>\n\n  <!-- Individual Menu Selection -->\n  <section class=\"qs-section\" aria-labelledby=\"menu-selection-title\">\n    <div class=\"qs-section-header\">\n      <h2 id=\"menu-selection-title\">Fresh Pani Puri Kits (Gol Gappe &amp; Puchka): Hand-Packed Daily on Oak Tree Road</h2>\n      <p>Whether you know them as Delhi-style Gol Gappe, Mumbai Pani Puri, or Kolkata Puchka, the secret to a great bite is keeping the pastry bone-dry until the exact second you eat it. We package each order as an assemble-at-home kit so you get the full street-side experience at your own dining table.</p>\n    </div>\n\n    <div class=\"qs-menu-grid\">\n      <article class=\"qs-item-card\">\n        <div>\n          <div class=\"qs-item-badge\">Oak Tree Rd Street Favorite</div>\n          <div class=\"qs-item-top\">\n            <h3>Classic Pani Puri Takeout Kit (8 Puris, $8.00)</h3>\n            <span class=\"qs-item-price\">$8.00</span>\n          </div>\n          <p>\n            Eight extra-crisp semolina puris boxed with individual containers: chilled stone-ground mint-cilantro water (teekha pani), dark date-tamarind chutney (meetha pani), spiced potato and black chickpea filling, and crunchy boondi.\n          </p>\n        </div>\n        <a class=\"qs-item-cta\" href=\"tel:+17322833799\">\n          <span>Call (732) 283-3799 to Order Ahead</span> &rarr;\n        </a>\n      </article>\n\n      <article class=\"qs-item-card\">\n        <div>\n          <div class=\"qs-item-badge\">Customer Top Pick</div>\n          <div class=\"qs-item-top\">\n            <h3>Dahi Puri (Sev Puri) To-Go (8 Puris, $8.00)</h3>\n            <span class=\"qs-item-price\">$8.00</span>\n          </div>\n          <p>\n            Eight puffed puris layered with seasoned potatoes, chilled whisked spiced yogurt, sweet date-tamarind chutney, sharp mint sauce, and a generous mountain of crispy nylon sev. Packed cold in a sturdy container.\n          </p>\n        </div>\n        <a class=\"qs-item-cta\" href=\"tel:+17322833799\">\n          <span>Call (732) 283-3799 to Order Ahead</span> &rarr;\n        </a>\n      </article>\n    </div>\n  </section>\n\n  <!-- Bulk Orders & Party Trays -->\n  <section class=\"qs-bulk-section\" aria-labelledby=\"bulk-orders-title\">\n    <div class=\"qs-section-header\">\n      <h2 id=\"bulk-orders-title\">Pani Puri Party Packs &amp; Bulk Platters for Gatherings (30 to 100+ Puris)</h2>\n      <p>\n        Planning a family dinner, birthday party, weekend gathering, or mandir puja in Edison, Iselin, or Woodbridge? Skip the grocery store boxes with stale shells. We pack fresh puris, generous tubs of chilled herb waters, and seasoned filling ready for your guests.\n      </p>\n    </div>\n\n    <div class=\"qs-bulk-grid\">\n      <article class=\"qs-bulk-card\">\n        <span class=\"qs-bulk-badge\">Family Box</span>\n        <h3>30 Puris Family Box ($28.00)</h3>\n        <div class=\"qs-bulk-price\">$28.00</div>\n        <p class=\"qs-bulk-notes\">\n          Great for 3 to 5 people. Includes 30 crisp puris in a crush-proof box, 16 oz chilled mint water, 16 oz sweet tamarind water, 16 oz potato-chana masala, and crispy boondi.\n        </p>\n        <a class=\"qs-btn qs-btn--gold\" href=\"tel:+17322833799\">Call to Reserve</a>\n      </article>\n\n      <article class=\"qs-bulk-card qs-bulk-card--featured\">\n        <span class=\"qs-bulk-badge\" style=\"background:var(--gold);color:#2a080f;\">Most Popular</span>\n        <h3>50 Puris Party Pack ($45.00)</h3>\n        <div class=\"qs-bulk-price\">$45.00</div>\n        <p class=\"qs-bulk-notes\">\n          Our top seller for home pujas and birthday get-togethers. Includes 50 puris, two full 32 oz tubs of cold spiced waters, 32 oz potato-chana filling, and boondi.\n        </p>\n        <a class=\"qs-btn qs-btn--gold\" href=\"tel:+17322833799\">Call to Reserve</a>\n      </article>\n\n      <article class=\"qs-bulk-card\">\n        <span class=\"qs-bulk-badge\">Community Pack</span>\n        <h3>100 Puris Community Kit ($85.00)</h3>\n        <div class=\"qs-bulk-price\">$85.00</div>\n        <p class=\"qs-bulk-notes\">\n          Best value for large family events, office lunches, and community gatherings. Packed with large bottles of both flavored waters and plenty of seasoned filling.\n        </p>\n        <a class=\"qs-btn qs-btn--gold\" href=\"tel:+17322833799\">Call to Reserve</a>\n      </article>\n\n      <article class=\"qs-bulk-card\">\n        <span class=\"qs-bulk-badge\">Large Event</span>\n        <h3>High-Volume Catering (250+ Pieces)</h3>\n        <div class=\"qs-bulk-price\">Volume Pricing</div>\n        <p class=\"qs-bulk-notes\">\n          Custom bulk kits and live chaat counter options for weddings, banquets, and temple festivals across NJ, NY, and CT. Direct event delivery available.\n        </p>\n        <a class=\"qs-btn qs-btn--white\" href=\"/catering/#quote-form\">Request Quote &rarr;</a>\n      </article>\n    </div>\n  </section>\n\n  <!-- How Spill-Proof Takeout Kits Work -->\n  <section class=\"qs-section\" aria-labelledby=\"kit-guide-title\">\n    <div class=\"qs-section-header\">\n      <h2 id=\"kit-guide-title\">How Our Spill-Proof Takeout Kits Work: Crisp Puris &amp; Chilled Waters</h2>\n      <p>Pani puri gets ruined when assembled ahead of time. Our kitchen divides every kit into dedicated, sealed containers so your food stays crisp and fresh all the way home.</p>\n    </div>\n\n    <div class=\"qs-kit-grid\">\n      <article class=\"qs-kit-card\">\n        <div class=\"qs-kit-number\">1</div>\n        <h3>Puris Protected in Rigid Boxes</h3>\n        <p>We pack our puris in sturdy, crush-proof containers that protect the delicate pastry shells during your drive through Central Jersey traffic.</p>\n      </article>\n\n      <article class=\"qs-kit-card\">\n        <div class=\"qs-kit-number\">2</div>\n        <h3>Sealed Chilled Waters (Teekha &amp; Meetha)</h3>\n        <p>Our stone-ground mint water and sweet tamarind sauce are sealed cold in leak-proof bottles. Keep them in your fridge until you are ready to pour.</p>\n      </article>\n\n      <article class=\"qs-kit-card\">\n        <div class=\"qs-kit-number\">3</div>\n        <h3>Seasoned Potato &amp; Black Chickpea Masala</h3>\n        <p>Our filling is prepared every morning with boiled potatoes, black chickpeas, roasted cumin, and black salt. Spoon it into each shell, add water, and enjoy.</p>\n      </article>\n    </div>\n  </section>\n\n  <!-- How to Order & Pickup Guidelines -->\n  <section class=\"qs-section\" aria-labelledby=\"pickup-guide-title\">\n    <div class=\"qs-section-header\">\n      <h2 id=\"pickup-guide-title\">How to Order &amp; Pickup at Our Iselin Store (1384 Oak Tree Rd)</h2>\n      <p>Quality Sweets runs as a focused counter shop without dining tables, which keeps counter waits short and your orders moving fast.</p>\n    </div>\n\n    <div class=\"qs-pickup-layout\">\n      <div>\n        <ol class=\"qs-step-list\">\n          <li class=\"qs-step-item\">\n            <h3>Step 1: Walk In or Call (732) 283-3799 Ahead</h3>\n            <p>For an individual 8-puri kit, walk right up to the counter. For a 30, 50, or 100-puri party pack, give us a quick call 1 to 2 hours ahead so we can box your components fresh.</p>\n          </li>\n          <li class=\"qs-step-item\">\n            <h3>Step 2: Chilled Waters &amp; Fresh Masala Packed to Order</h3>\n            <p>We keep our flavored waters chilled in commercial refrigerators and pack your containers right before you arrive so nothing warms up on the counter.</p>\n          </li>\n          <li class=\"qs-step-item\">\n            <h3>Step 3: Easy Storefront Parking &amp; Fast Counter Checkout</h3>\n            <p>Park right in our lot along Oak Tree Road, step inside to collect your boxed order, and be on your way in minutes.</p>\n          </li>\n        </ol>\n      </div>\n\n      <div class=\"qs-map-box\">\n        <div class=\"qs-store-meta\">\n          <strong>Quality Sweets (Taste The Tradition)</strong><br>\n          1384 Oak Tree Road, Iselin, NJ 08830<br>\n          <strong>Phone:</strong> <a href=\"tel:+17322833799\" style=\"color:var(--wine);font-weight:700;\">(732) 283-3799</a><br>\n          <strong>Hours:</strong> Open 7 Days a Week, 10:00 AM &ndash; 8:00 PM<br>\n          <strong>Service Type:</strong> Counter Takeout &amp; Pickup Only (No Dine-In)\n        </div>\n        <iframe\n          class=\"qs-map-iframe\"\n          title=\"Quality Sweets Store Location in Iselin NJ\"\n          src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3032.5312384918237!2d-74.3283548!3d40.5739404!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c3b6f9f38c7ef3%3A0xbca60fbc875b1c57!2sQuality%20Sweets!5e0!3m2!1sen!2sus!4v1710000000000!5m2!1sen!2sus\"\n          loading=\"lazy\"\n          referrerpolicy=\"no-referrer-when-downgrade\">\n        </iframe>\n      </div>\n    </div>\n  </section>\n\n  <!-- Kitchen Quality Standards -->\n  <section class=\"qs-section\" aria-labelledby=\"standards-title\">\n    <div class=\"qs-section-header\">\n      <h2 id=\"standards-title\">The Quality Sweets Kitchen Standard: Real Herbs &amp; Filtered Chilled Water</h2>\n      <p>Customers throughout Middlesex County come to Oak Tree Road because they know we grind real herbs fresh every morning instead of using powdered premixes.</p>\n    </div>\n\n    <div class=\"qs-standards-grid\">\n      <article class=\"qs-standard-card\">\n        <h3>Stone-Ground Mint &amp; Cilantro Teekha Pani</h3>\n        <p>Blended fresh daily with raw mint leaves, coriander, green chilies, roasted cumin, and black salt in cold filtered water. Crisp, herbal, and clean.</p>\n      </article>\n\n      <article class=\"qs-standard-card\">\n        <h3>Slow-Simmered Tamarind &amp; Jaggery Meetha Pani</h3>\n        <p>Made by simmering pure tamarind pulp with dark jaggery, ginger powder, and spices. Smooth, sweet, and perfectly tangy with zero artificial coloring.</p>\n      </article>\n\n      <article class=\"qs-standard-card\">\n        <h3>Crisp Hand-Fried Puris &amp; 100% Pure Vegetarian Kitchen</h3>\n        <p>Our pastry shells are fried in fresh vegetable oil until paper-thin and crunchy. Prepared in a strictly pure vegetarian kitchen free of animal fats and gelatin.</p>\n      </article>\n    </div>\n  </section>\n\n  <!-- Cross-Sell Nationwide Sweets Notice -->\n  <div class=\"qs-cross-sell\">\n    <div class=\"qs-cross-sell-text\">\n      <strong>Looking for Indian Sweets Delivered Across the United States?</strong>\n      <p>While our pani puri kits and hot chaats are exclusively for in-person pickup on Oak Tree Road, our complete line of fresh mithai (Bengali sweets, Kaju Katli, and gift boxes) ships nationwide to all 50 states in insulated cold packs.</p>\n    </div>\n    <a class=\"qs-btn qs-btn--gold\" href=\"/indian-sweets/\">Shop Sweets for USA Delivery &rarr;</a>\n  </div>\n\n  <!-- Frequently Asked Questions -->\n  <section class=\"qs-section qs-faq\" aria-labelledby=\"faq-title\">\n    <div class=\"qs-section-header\">\n      <h2 id=\"faq-title\">Frequently Asked Questions: Pani Puri Pickup in Iselin, NJ</h2>\n      <p>Quick answers on kit contents, shelf life, and ordering party boxes.</p>\n    </div>\n\n    <details open>\n      <summary>Will the puris get soggy on the ride home?</summary>\n      <p>No. We never assemble pani puris ahead of time. Puris are boxed completely dry, and waters and fillings are sealed in separate spill-proof containers. They will stay crunchy as long as they remain dry.</p>\n    </details>\n\n    <details>\n      <summary>Can I eat pani puri inside the store?</summary>\n      <p>No. Quality Sweets operates strictly as a takeout counter and pickup shop with no dining tables. All kits are packed sturdy and cold to enjoy wherever you are heading.</p>\n    </details>\n\n    <details>\n      <summary>Can pani puri kits be shipped to other states?</summary>\n      <p>No. Prepared street foods and chilled flavored waters cannot survive postal transport. They are sold strictly for counter pickup at 1384 Oak Tree Road. For gift shipments, browse our <a href=\"/indian-sweets/\">nationwide sweets collection</a>.</p>\n    </details>\n\n    <details>\n      <summary>How spicy is the mint water? Can I get only sweet water?</summary>\n      <p>Our classic mint water has a moderate, authentic kick from green chilies and ginger. Every kit also includes sweet date-tamarind water, so you can mix both in each puri to dial in your exact spice preference. If you prefer only sweet water, just ask our counter staff.</p>\n    </details>\n\n    <details>\n      <summary>How far in advance should I order a 50 or 100-puri party pack?</summary>\n      <p>For party trays of 50 or 100 puris, giving us a call 1 to 2 hours in advance is ideal so we can package fresh waters and filling. For large festival or wedding orders (250+ pieces), please call 24 to 48 hours ahead.</p>\n    </details>\n\n    <details>\n      <summary>Are the ingredients 100% vegetarian?</summary>\n      <p>Yes. Everything is 100% pure vegetarian, made with potatoes, chickpeas, herbs, spices, semolina, and vegetable oil. No meat, poultry, gelatin, or animal shortening is used in our kitchen.</p>\n    </details>\n  </section>\n\n  <!-- Cluster Internal Linking -->\n  <footer class=\"qs-section\" style=\"border-top:1px solid var(--border);padding-top:24px;\">\n    <h2>Explore More from Our Iselin Takeout Menu</h2>\n    <p>Pair your pani puri kits with freshly fried snacks and traditional sweets from our Oak Tree Road counter:</p>\n    <div class=\"qs-cluster-nav\">\n      <a href=\"/menu/\">Complete Takeout Menu</a>\n      <a href=\"/menu/samosas/\">Fresh Samosas &amp; Samosa Chaat ($1.75 / $8.00)</a>\n      <a href=\"/menu/chaats/\">Chaat Selection (Dahi Bhalla &amp; Papri Chaat)</a>\n      <a href=\"/menu/street-food-snacks/\">Street Food &amp; Snacks (Chole Bhatura &amp; Parathas)</a>\n      <a href=\"/menu/mithai-counter/\">Fresh Mithai Counter ($/lb)</a>\n      <a href=\"/menu/drinks/\">Drinks (Mango Lassi &amp; Masala Chai)</a>\n      <a href=\"/catering/\">Tri-State Catering &amp; Bulk Orders</a>\n      <a href=\"/locations/iselin-nj/\">Visit Our Iselin Store on Oak Tree Rd</a>\n    </div>\n  </footer>\n\n</main>\n\n<script id=\"qs-pani-puri-heading-fix\">\n(function() {\n  function fixHeadings() {\n    Array.prototype.slice.call(document.querySelectorAll('h2')).forEach(function(n) {\n      if (n.textContent.trim().toLowerCase() === 'categories') {\n        var d = document.createElement('div');\n        Array.prototype.forEach.call(n.attributes, function(a) { d.setAttribute(a.name, a.value); });\n        d.innerHTML = n.innerHTML;\n        n.parentNode.replaceChild(d, n);\n      }\n    });\n    Array.prototype.slice.call(document.querySelectorAll('h1')).forEach(function(h) {\n      if (h.classList.contains('TitleHeading') || h.textContent.trim().indexOf('Crisp Pani Puri & Gol Gappe') > -1 && h.closest('.qs-hero') === null) {\n        h.remove();\n      }\n    });\n  }\n  fixHeadings();\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', fixHeadings);\n  } else {\n    fixHeadings();\n  }\n})();\n</script>\n",
