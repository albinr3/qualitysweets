      "uuid": "548612e1-c479-44a6-80b0-b173bf7c8683",
      "name": "Category Labels Without Headings",
      "description": "Converts duplicate legacy Categories H2 elements into non-semantic labels.",
      "html": "<script id=\"qs-category-labels-not-headings\">(function(){function replaceCategoryHeadings(){document.querySelectorAll(\"h2\").forEach(function(oldNode){if(oldNode.textContent.trim().toLowerCase()!==\"categories\")return;var replacement=document.createElement(\"div\");Array.prototype.forEach.call(oldNode.attributes,function(attribute){replacement.setAttribute(attribute.name,attribute.value);});replacement.classList.add(\"qs-category-label\");replacement.innerHTML=oldNode.innerHTML;oldNode.parentNode.replaceChild(replacement,oldNode);});}if(document.readyState===\"loading\"){document.addEventListener(\"DOMContentLoaded\",replaceCategoryHeadings,{once:true});}else{replaceCategoryHeadings();}}());</script>",
      "src": "",
      "auto_uninstall": true,
      "load_method": "default",
      "location": "footer",
      "visibility": "storefront",
      "kind": "script_tag",
      "date_created": "2026-09-12T20:18:20.123Z",
      "date_modified": "2026-09-12T20:18:42.300Z",
