    "name": "Site Verification Tags",
    "code": "<!-- Google tag (gtag.js) - Google Analytics 4 (Quality Sweets Standard Telemetry v3) -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-34WFEPDKY8\"></script>\n<script id=\"qs-ga4-interaction-events-v3\">\n(function () {\n  \"use strict\";\n  var startedCateringQuote = false;\n  var leadSubmitted = false;\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){window.dataLayer.push(arguments);}\n  window.gtag = window.gtag || gtag;\n  window.gtag(\"js\", new Date());\n  window.gtag(\"config\", \"G-34WFEPDKY8\", {\n    ignore_referrer: \"store-2ygwtj.mybigcommerce.com,qualitysweetsnj.com\"\n  });\n\n  function pageType() {\n    var currentPath = window.location.pathname.toLowerCase();\n    if (currentPath.indexOf(\"/catering/\") === 0) return \"catering\";\n    if (currentPath.indexOf(\"/menu/\") === 0) return \"takeout_menu\";\n    if (currentPath.indexOf(\"/locations/\") === 0) return \"location\";\n    if (currentPath === \"/contact-us/\") return \"contact\";\n    if (document.querySelector('meta[property=\"og:type\"][content=\"product\"]')) return \"product\";\n    return \"storefront\";\n  }\n\n  function send(name, params) {\n    var eventParams = params || {};\n    eventParams.page_type = eventParams.page_type || pageType();\n    if (typeof window.gtag === \"function\") {\n      window.gtag(\"event\", name, eventParams);\n      return;\n    }\n    window.dataLayer = window.dataLayer || [];\n    window.dataLayer.push([\"event\", name, eventParams]);\n  }\n\n  function ctaLocation(link) {\n    if (!link || !link.closest) return \"page_content\";\n    if (link.closest(\"header\")) return \"header\";\n    if (link.closest(\"footer\")) return \"footer\";\n    if (link.closest(\".qs-catering\")) return \"catering_content\";\n    if (link.closest(\".qs-menu\")) return \"takeout_menu_content\";\n    return \"page_content\";\n  }\n\n  // Click listeners for Phone, Email, Directions, Cart & Checkout\n  document.addEventListener(\"click\", function (event) {\n    var link = event.target.closest && event.target.closest(\"a[href]\");\n    if (!link) return;\n    var href = link.getAttribute(\"href\") || \"\";\n    var lowerHref = href.toLowerCase();\n    var loc = ctaLocation(link);\n\n    // Standardized Phone Call Tracking (click_call)\n    if (lowerHref.indexOf(\"tel:\") === 0) {\n      send(\"click_call\", {\n        cta_location: loc,\n        link_url: href,\n        page_location: window.location.href\n      });\n    }\n    // Standardized Email Click Tracking (click_email)\n    else if (lowerHref.indexOf(\"mailto:\") === 0) {\n      send(\"click_email\", {\n        cta_location: loc,\n        link_url: href,\n        page_location: window.location.href\n      });\n    }\n    // Secondary Directions Click\n    else if (lowerHref.indexOf(\"maps.app.goo.gl\") !== -1 || lowerHref.indexOf(\"google.com/maps\") !== -1) {\n      send(\"click_directions\", {\n        cta_location: loc,\n        page_location: window.location.href\n      });\n    }\n    // Direct add to cart links\n    else if (lowerHref.indexOf(\"cart.php?action=add\") !== -1) {\n      var directProductMatch = lowerHref.match(/[?&]product_id=(\\d+)/);\n      send(\"add_to_cart\", {\n        cta_location: loc,\n        items: directProductMatch ? [{ item_id: directProductMatch[1] }] : []\n      });\n    }\n    // Begin checkout links\n    else if (lowerHref.indexOf(\"checkout.php\") !== -1) {\n      send(\"begin_checkout\", { cta_location: loc });\n    }\n  });\n\n  function productItem(form) {\n    if (!form) return null;\n    var input = form.querySelector('input[name=\"product_id\"]');\n    if (!input || !input.value) return null;\n    var heading = document.querySelector('#ProductDetails h1, .PrimaryProductDetails h1, h1');\n    var item = { item_id: input.value };\n    if (heading && heading.textContent.trim()) item.item_name = heading.textContent.trim();\n    return item;\n  }\n\n  function setupEcommerceEvents() {\n    var productForm = document.getElementById(\"productDetailsAddToCartForm\");\n    var item = productItem(productForm);\n    if (item) {\n      send(\"view_item\", { items: [item] });\n      productForm.addEventListener(\"submit\", function () {\n        send(\"add_to_cart\", { items: [item] });\n      });\n    }\n    if (window.location.pathname.toLowerCase().indexOf(\"/cart.php\") === 0 && window.location.search.toLowerCase().indexOf(\"action=add\") === -1) {\n      send(\"view_cart\", { items: [] });\n    }\n  }\n\n  // Catering Form Telemetry (catering_quote_start & generate_lead - NO PII)\n  function setupCateringForm() {\n    var cateringForm = document.getElementById(\"b2b-catering-form\") || document.querySelector(\"form.qs-catering-form, form[action*='catering']\");\n    if (!cateringForm) return;\n\n    cateringForm.addEventListener(\"focusin\", function () {\n      if (startedCateringQuote) return;\n      startedCateringQuote = true;\n      send(\"catering_quote_start\", {\n        cta_location: \"catering_form\",\n        page_location: window.location.href\n      });\n    });\n\n    cateringForm.addEventListener(\"change\", function (event) {\n      var target = event.target;\n      if (!target || (target.name !== \"event_type\" && target.name !== \"service\")) return;\n      send(\"select_catering_service\", {\n        cta_location: \"catering_form\",\n        service_type: target.value || \"unspecified\"\n      });\n    });\n\n    cateringForm.addEventListener(\"submit\", function (e) {\n      if (leadSubmitted) return;\n      if (typeof cateringForm.checkValidity === \"function\" && !cateringForm.checkValidity()) return;\n      leadSubmitted = true;\n      send(\"generate_lead\", {\n        form_id: \"b2b_catering_form\",\n        form_name: \"Catering & Bulk Order Inquiry\",\n        service_type: \"catering\",\n        cta_location: \"catering_form\",\n        page_location: window.location.href\n      });\n    });\n  }\n\n  // Contact Form Telemetry (generate_lead - NO PII)\n  function setupContactForm() {\n    var contactForm = document.querySelector(\"form.contact-form, form[action*='contact'], .PageContent form\");\n    if (!contactForm || contactForm.id === \"b2b-catering-form\") return;\n\n    contactForm.addEventListener(\"submit\", function (e) {\n      if (leadSubmitted) return;\n      if (typeof contactForm.checkValidity === \"function\" && !contactForm.checkValidity()) return;\n      leadSubmitted = true;\n      send(\"generate_lead\", {\n        form_id: \"contact_us_form\",\n        form_name: \"Store Contact Inquiry\",\n        service_type: \"contact\",\n        cta_location: \"contact_page\",\n        page_location: window.location.href\n      });\n    });\n  }\n\n  function init() {\n    setupCateringForm();\n    setupContactForm();\n    setupEcommerceEvents();\n    if (window.location.pathname.toLowerCase().indexOf(\"/menu/\") === 0) {\n      send(\"view_takeout_menu\", { cta_location: \"page_load\" });\n    }\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", init, { once: true });\n  } else {\n    init();\n  }\n})();\n</script>\n<script id=\"qs-footer-nap\">\n(function () {\n  function applyFooterStructure() {\n    var footerUpper = document.getElementById('FooterUpper');\n    if (!footerUpper) return;\n\n    // 1. Ensure NAP in Column 0 (Contact)\n    var contact = footerUpper.querySelector('.Column.contact .custom_content') || \n                  document.querySelector('#block_2 .custom_content');\n    if (contact && !contact.querySelector('.qs-footer-nap-name')) {\n      if (!contact.getAttribute('itemscope')) {\n        contact.setAttribute('itemscope', '');\n        contact.setAttribute('itemtype', 'https://schema.org/SweetShop');\n      }\n      var nameEl = document.createElement('div');\n      nameEl.className = 'qs-footer-nap-name';\n      nameEl.setAttribute('itemprop', 'name');\n      nameEl.textContent = 'Quality Sweets - Indian Sweets Shop';\n      nameEl.style.cssText = 'color: #ffd700; font-family: \"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif; font-weight: 700; font-size: 14.5px; line-height: 1.35; margin-bottom: 5px; display: block; letter-spacing: 0.2px;';\n      \n      var icon1 = contact.querySelector('.icon1');\n      if (icon1) {\n        if (!icon1.getAttribute('itemprop')) {\n          icon1.setAttribute('itemprop', 'address');\n          icon1.setAttribute('itemscope', '');\n          icon1.setAttribute('itemtype', 'https://schema.org/PostalAddress');\n        }\n        contact.insertBefore(nameEl, icon1);\n      } else {\n        contact.prepend(nameEl);\n      }\n      var icon2 = contact.querySelector('.icon2');\n      if (icon2 && !icon2.getAttribute('itemprop')) icon2.setAttribute('itemprop', 'telephone');\n      var icon3Link = contact.querySelector('.icon3 a');\n      if (icon3Link && !icon3Link.getAttribute('itemprop')) icon3Link.setAttribute('itemprop', 'email');\n    }\n\n    // 2. Transform Link Columns (Shop, Visit & Order, About & Help)\n    if (!footerUpper.querySelector('#qs-footer-shop')) {\n      var columns = footerUpper.querySelectorAll(':scope > .Column');\n      if (columns.length >= 3) {\n        // Column 1: Shop\n        var colShop = columns[1];\n        if (colShop) {\n          colShop.className = 'Column qs-col-shop';\n          colShop.innerHTML = [\n            '<div class=\"footer-area Block\" id=\"qs-footer-shop\">',\n            '  <h3>Shop</h3>',\n            '  <div class=\"custom_content BlockContent\">',\n            '    <ul>',\n            '      <li><a href=\"/indian-sweets/\">All Indian Sweets</a></li>',\n            '      <li><a href=\"/barfi/\">Barfi &amp; Kaju Katli</a></li>',\n            '      <li><a href=\"/bengali-sweets/\">Bengali Sweets</a></li>',\n            '      <li><a href=\"/indian-snacks/\">Indian Snacks &amp; Namkeen</a></li>',\n            '      <li><a href=\"/mithai-box/\">Mithai Boxes &amp; Gift Baskets</a></li>',\n            '    </ul>',\n            '  </div>',\n            '</div>'\n          ].join('\\n');\n        }\n\n        // Column 2: Visit & Order\n        var colVisit = columns[2];\n        if (colVisit) {\n          colVisit.className = 'Column qs-col-visit';\n          colVisit.innerHTML = [\n            '<div class=\"footer-area Block\" id=\"qs-footer-visit\">',\n            '  <h3>Visit &amp; Order</h3>',\n            '  <div class=\"custom_content BlockContent\">',\n            '    <ul>',\n            '      <li><a href=\"/menu/\">Takeout Menu</a></li>',\n            '      <li><a href=\"/catering/\">Catering &amp; Bulk Orders</a></li>',\n            '      <li><a href=\"/locations/iselin-nj/\">Quality Sweets Iselin NJ Store</a></li>',\n            '      <li><a href=\"/contact-us/\">Contact Us</a></li>',\n            '    </ul>',\n            '  </div>',\n            '</div>'\n          ].join('\\n');\n        }\n\n        // Column 3: About & Help (Column last)\n        var colAbout = columns.length >= 4 ? columns[3] : document.createElement('div');\n        colAbout.className = 'Column last qs-col-about';\n        colAbout.style.display = 'block';\n        colAbout.innerHTML = [\n          '<div class=\"footer-area Block\" id=\"qs-footer-about\">',\n          '  <h3>About &amp; Help</h3>',\n          '  <div class=\"custom_content BlockContent\">',\n          '    <ul>',\n          '      <li><a href=\"/about-us/\">About Us</a></li>',\n          '      <li><a href=\"/shipping-refunds/\">Shipping &amp; Refunds</a></li>',\n          '      <li><a href=\"/packaging-information/\">Packaging Information</a></li>',\n          '      <li><a href=\"/security-and-privacy/\">Security &amp; Privacy</a></li>',\n          '      <li><a href=\"/blog/\">Blog</a></li>',\n          '      <li><a href=\"/sitemap/\">Sitemap</a></li>',\n          '    </ul>',\n          '  </div>',\n          '</div>'\n        ].join('\\n');\n        if (columns.length < 4) footerUpper.appendChild(colAbout);\n      }\n    }\n\n    // 3. Apply layout styling\n    if (!document.getElementById('qs-footer-layout-style')) {\n      var style = document.createElement('style');\n      style.id = 'qs-footer-layout-style';\n      style.textContent = [\n        '#FooterUpper { display: flex !important; flex-wrap: wrap !important; justify-content: space-between !important; gap: 20px !important; }',\n        '#FooterUpper > .Column { float: none !important; margin: 0 !important; display: block !important; }',\n        '#FooterUpper > .Column.contact { flex: 1 1 270px !important; max-width: 310px !important; }',\n        '#FooterUpper > .Column:not(.contact) { flex: 1 1 180px !important; max-width: 230px !important; }',\n        '#FooterUpper .BlockContent ul { list-style: none !important; padding: 0 !important; margin: 0 !important; }',\n        '#FooterUpper .BlockContent li { font-size: 13.5px !important; line-height: 27px !important; padding: 0 0 0 14px !important; margin: 0 !important; }',\n        '#FooterUpper .BlockContent li a { color: #fce8cc !important; text-decoration: none !important; transition: color 0.18s ease !important; font-family: \"Plus Jakarta Sans\", sans-serif !important; }',\n        '#FooterUpper .BlockContent li a:hover { color: #ffd700 !important; text-decoration: underline !important; }',\n        '#FooterUpper h2, #FooterUpper h3, #FooterUpper .Column h3 { font-family: \"Marcellus\", Georgia, serif !important; font-size: 19px !important; color: #d4af37 !important; margin: 0 0 12px 0 !important; }',\n        '@media (max-width: 800px) { #FooterUpper > .Column { flex: 1 1 45% !important; max-width: 48% !important; } }',\n        '@media (max-width: 520px) { #FooterUpper > .Column { flex: 1 1 100% !important; max-width: 100% !important; } }'\n      ].join('\\n');\n      document.head.appendChild(style);\n    }\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', applyFooterStructure, { once: true });\n  } else {\n    applyFooterStructure();\n  }\n  window.addEventListener('load', applyFooterStructure, { once: true });\n})();\n</script>\n<script id=\"qs-header-takeout-nav\">\n(function () {\n  function injectTakeoutMenu() {\n    var menus = document.querySelectorAll('.SideCategoryListFlyout > ul.sf-menu');\n    if (!menus || menus.length === 0) return;\n\n    menus.forEach(function (menu) {\n      if (menu.querySelector('.qs-nav-takeout')) return;\n\n      var li = document.createElement('li');\n      li.className = 'qs-nav-takeout';\n      li.innerHTML = '<a href=\"/menu/\">Takeout Menu</a>' +\n        '<ul>' +\n          '<li><a href=\"/menu/chaats/\">Chaat Counter</a></li>' +\n          '<li><a href=\"/menu/street-food-snacks/\">Hot Street Food &amp; Snacks</a></li>' +\n          '<li><a href=\"/menu/mithai-counter/\">Mithai Counter (In-Store)</a></li>' +\n          '<li><a href=\"/menu/drinks/\">Drinks &amp; Lassi</a></li>' +\n        '</ul>';\n\n      // Insert before Catering if present, otherwise append\n      var cateringLi = Array.from(menu.children).find(function (el) {\n        var a = el.querySelector(':scope > a');\n        return a && a.getAttribute('href') && a.getAttribute('href').indexOf('/catering/') !== -1;\n      });\n\n      if (cateringLi) {\n        menu.insertBefore(li, cateringLi);\n      } else {\n        menu.appendChild(li);\n      }\n    });\n\n    if (window.jQuery && typeof window.jQuery.fn.superfish === 'function') {\n      try { window.jQuery('ul.sf-menu').superfish(); } catch (e) {}\n    }\n  }\n\n  if (!document.getElementById('qs-header-takeout-style')) {\n    var style = document.createElement('style');\n    style.id = 'qs-header-takeout-style';\n    style.textContent = [\n      '#Header .PageMenu ul.sf-horizontal > li.qs-nav-takeout { flex: 0 1 auto !important; white-space: nowrap !important; }',\n      '#Header .PageMenu ul.sf-horizontal > li.qs-nav-takeout > a { font-weight: 700 !important; }',\n      '#Header .PageMenu ul.sf-horizontal > li.qs-nav-takeout:hover > ul { display: block !important; }',\n      '#Header .PageMenu ul.sf-horizontal > li.qs-nav-takeout ul { min-width: 220px !important; }',\n      '@media screen and (min-width: 1101px) {',\n      '  #Header .PageMenu #SideCategoryList > .BlockContent > .SideCategoryListFlyout > ul > li > a { font-size: 14.5px !important; padding: 12px 7px !important; }',\n      '}'\n    ].join('\\n');\n    document.head.appendChild(style);\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', injectTakeoutMenu, { once: true });\n  } else {\n    injectTakeoutMenu();\n  }\n  window.addEventListener('load', injectTakeoutMenu, { once: true });\n})();\n</script>\n\n<!-- QUALITY SWEETS - PDP SHIPPING & FEDEX TRANSIT WIDGET -->\n<script id=\"qs-pdp-shipping-transit-widget\">\n(function() {\n  function injectShippingWidget() {\n    var form = document.getElementById('productDetailsAddToCartForm');\n    if (!form) return;\n    if (document.getElementById('qs-pdp-shipping-widget')) return;\n\n    var container = document.createElement('div');\n    container.id = 'qs-pdp-shipping-widget';\n    container.style.cssText = 'margin: 18px 0 14px 0; background: #fdfbf7; border: 1.5px solid #ebdcc5; border-radius: 10px; padding: 14px 16px; font-family: \"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif; box-sizing: border-box; clear: both; box-shadow: 0 2px 8px rgba(0,0,0,0.04);';\n\n    container.innerHTML = [\n      '<div style=\"display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid rgba(212, 175, 55, 0.35);\">',\n      '  <div style=\"display: flex; align-items: center; gap: 8px; color: #7a1526; font-family: \\'Marcellus\\', Georgia, serif; font-size: 15.5px; font-weight: 700;\">',\n      '    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#7a1526\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: middle;\"><rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect><polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle></svg>',\n      '    <span>Nationwide Delivery &bull; FedEx Transit Schedule</span>',\n      '  </div>',\n      '  <span style=\"background: rgba(212, 175, 55, 0.2); border: 1px solid #d4af37; color: #6e101e; font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 3px 8px; border-radius: 4px; letter-spacing: 0.5px;\">Cold-Pack Insulated</span>',\n      '</div>',\n      '<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px; margin-bottom: 12px; font-size: 12px; color: #4a0e17;\">',\n      '  <div style=\"background: #ffffff; border: 1px solid #ebdcc5; border-radius: 6px; padding: 7px 9px;\">',\n      '    <strong style=\"color: #e6007e; display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.3px;\">Tri-State Core</strong>',\n      '    <span>1 Day (NJ, NY, CT, PA)</span>',\n      '  </div>',\n      '  <div style=\"background: #ffffff; border: 1px solid #ebdcc5; border-radius: 6px; padding: 7px 9px;\">',\n      '    <strong style=\"color: #008fa0; display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.3px;\">Midwest &amp; South</strong>',\n      '    <span>2 Days Delivery</span>',\n      '  </div>',\n      '  <div style=\"background: #ffffff; border: 1px solid #ebdcc5; border-radius: 6px; padding: 7px 9px;\">',\n      '    <strong style=\"color: #d97706; display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.3px;\">Texas &amp; West</strong>',\n      '    <span>3 to 5 Days</span>',\n      '  </div>',\n      '</div>',\n      '<button type=\"button\" id=\"qs-btn-toggle-transit-map\" style=\"width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; background: #ffffff; border: 1.5px solid #d4af37; color: #7a1526; font-family: \\'Plus Jakarta Sans\\', sans-serif; font-size: 13px; font-weight: 700; padding: 9px 14px; border-radius: 6px; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 2px 6px rgba(0,0,0,0.04);\">',\n      '  <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#7a1526\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -2px; display: inline-block;\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>',\n      '  <span>View FedEx Transit Map &amp; Delivery Days</span>',\n      '  <svg id=\"qs-map-arrow\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#7a1526\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"transition: transform 0.2s ease; margin-left: 2px;\"><path d=\"m6 9 6 6 6-6\"/></svg>',\n      '</button>',\n      '<div id=\"qs-pdp-map-drawer\" style=\"display: none; margin-top: 14px; padding-top: 14px; border-top: 1px dashed #ebdcc5; text-align: center;\">',\n      '  <div style=\"background: #ffffff; border: 1px solid #ebdcc5; border-radius: 8px; padding: 10px; margin-bottom: 10px;\">',\n      '    <img src=\"https://cdn10.bigcommerce.com/s-2ygwtj/products/176/images/419/fedex_ground_transit_map_nj__73504.1792114202.1280.1280.png?c=2\" alt=\"FedEx Ground Transit Schedule Map Quality Sweets\" style=\"width: 100%; height: auto; max-width: 480px; display: block; margin: 0 auto; border-radius: 4px;\" loading=\"lazy\" />',\n      '  </div>',\n      '  <p style=\"font-size: 12px; color: #555; line-height: 1.5; margin: 0 0 8px 0; text-align: left;\">',\n      '    <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#7a1526\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: -2px; display: inline-block; margin-right: 4px;\"><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\" ry=\"2\"></rect><line x1=\"16\" x2=\"16\" y1=\"2\" y2=\"6\"></line><line x1=\"8\" x2=\"8\" y1=\"2\" y2=\"6\"></line><line x1=\"3\" x2=\"21\" y1=\"10\" y2=\"10\"></line></svg>',\n      '    <strong>Dispatch Schedule:</strong> Orders ship <strong>Monday through Wednesday</strong> via FedEx Ground to ensure sweets arrive fresh without weekend transit holds. Made daily with 0 chemical preservatives.',\n      '  </p>',\n      '  <div style=\"text-align: right;\">',\n      '    <a href=\"/shipping-refunds/\" target=\"_blank\" style=\"color: #7a1526; font-size: 12.5px; font-weight: 700; text-decoration: underline;\">Open Full Shipping Policy &rarr;</a>',\n      '  </div>',\n      '</div>'\n    ].join('\\n');\n\n    var addto = form.querySelector('.addto');\n    if (addto && addto.parentNode) {\n      addto.parentNode.insertBefore(container, addto.nextSibling);\n    } else {\n      form.appendChild(container);\n    }\n\n    var toggleBtn = document.getElementById('qs-btn-toggle-transit-map');\n    var drawer = document.getElementById('qs-pdp-map-drawer');\n    var arrow = document.getElementById('qs-map-arrow');\n    if (toggleBtn && drawer && arrow) {\n      toggleBtn.addEventListener('click', function(e) {\n        e.preventDefault();\n        var isOpen = drawer.style.display !== 'none';\n        drawer.style.display = isOpen ? 'none' : 'block';\n        arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';\n        toggleBtn.style.background = isOpen ? '#ffffff' : '#f4eee4';\n      });\n    }\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', injectShippingWidget, { once: true });\n  } else {\n    injectShippingWidget();\n  }\n  window.addEventListener('load', injectShippingWidget, { once: true });\n})();\n</script>\n\n<!-- QUALITY SWEETS - PDP HEADING HIERARCHY REPAIR (SEO & ACCESSIBILITY) -->\n<script id=\"qs-pdp-heading-hierarchy-repair\">\n(function() {\n  function retag(el, newTagName, addClass) {\n    if (!el || el.tagName.toLowerCase() === newTagName.toLowerCase()) return el;\n    var newEl = document.createElement(newTagName);\n    for (var i = 0; i < el.attributes.length; i++) {\n      var attr = el.attributes[i];\n      newEl.setAttribute(attr.name, attr.value);\n    }\n    while (el.firstChild) {\n      newEl.appendChild(el.firstChild);\n    }\n    if (addClass) newEl.classList.add(addClass);\n    if (el.parentNode) el.parentNode.replaceChild(newEl, el);\n    return newEl;\n  }\n\n  function repairPdpHeadings() {\n    var isPdp = document.body.classList.contains('productPage') || \n                document.getElementById('productDetailsAddToCartForm') ||\n                document.querySelector('.ProductMain');\n    if (!isPdp) return;\n\n    // 1. Pre-H1 Drawer and Header categories: retag to span so H1 is the very first heading\n    var preH2s = document.querySelectorAll('#DrawerMenu .CategoryList h2, #Header .CategoryList h2, .PageMenu #SideCategoryList h2');\n    preH2s.forEach(function(h2) {\n      retag(h2, 'span', 'qs-cat-nav-title');\n    });\n\n    // 2. Remove empty H4 BrandName under H1\n    var brandH4 = document.querySelector('.ProductMain h4.BrandName');\n    if (brandH4) {\n      if (!brandH4.textContent.trim()) {\n        var valParent = brandH4.closest('.Value');\n        if (valParent && !valParent.textContent.trim()) {\n          valParent.remove();\n        } else {\n          brandH4.remove();\n        }\n      }\n    }\n\n    // 3. Review form H5 -> H3 to prevent level skip under H2 Product Reviews\n    var reviewH5 = document.querySelector('#rating_box h5, #ProductReviews h5');\n    if (reviewH5) {\n      retag(reviewH5, 'h3', 'qs-review-form-title');\n    }\n\n    // 4. Sidebar utility headings in .Left -> H3 to avoid competing with PDP H2 sections\n    var sideH2s = document.querySelectorAll('.Left #SideCategoryList h2, .Left #SidePopularProducts h2, .Left #SideNewsletterBox h2, .Left .Block h2');\n    sideH2s.forEach(function(h2) {\n      retag(h2, 'h3', 'qs-side-h3');\n    });\n\n    // 5. Footer utility headings in #FooterUpper -> H3\n    var footerHeadings = document.querySelectorAll('#FooterUpper h2, #FooterUpper h4, .footer-main h2, .footer-main h4');\n    footerHeadings.forEach(function(h) {\n      retag(h, 'h3', 'qs-footer-h3');\n    });\n  }\n\n  // Inject companion CSS for seamless visual styling\n  if (!document.getElementById('qs-pdp-heading-repair-style')) {\n    var style = document.createElement('style');\n    style.id = 'qs-pdp-heading-repair-style';\n    style.textContent = [\n      '.PageMenu #SideCategoryList .qs-cat-nav-title { display: none !important; }',\n      '#DrawerMenu .qs-cat-nav-title { display: block; font-family: Oswald, sans-serif; font-size: 16px; font-weight: 600; color: #5b1e19; margin: 0 0 10px 0; padding: 10px 15px; }',\n      '.Left h3.qs-side-h3 { border-bottom: 1px dashed #D9D6C8 !important; color: #840B17 !important; padding: 0 0 10px !important; font-family: Oswald, \"Plus Jakarta Sans\", sans-serif !important; font-size: 16px !important; font-weight: 700 !important; margin: 0 0 10px 0 !important; text-transform: uppercase !important; }',\n      '#rating_box h3.qs-review-form-title { font-size: 15px !important; font-weight: 700 !important; color: #7a1526 !important; font-family: \"Marcellus\", Georgia, serif !important; margin: 15px 0 10px 0 !important; }',\n      '#FooterUpper h3.qs-footer-h3, #FooterUpper .Block h3.qs-footer-h3 { font-family: \"Marcellus\", Georgia, serif !important; font-size: 19px !important; color: #d4af37 !important; margin: 0 0 12px 0 !important; font-weight: 700 !important; }'\n    ].join('\\n');\n    document.head.appendChild(style);\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', repairPdpHeadings, { once: true });\n  } else {\n    repairPdpHeadings();\n  }\n  window.addEventListener('load', repairPdpHeadings, { once: true });\n})();\n</script>\n",
