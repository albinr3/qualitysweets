  "meta_title": "Indian Catering Near Me | Wedding, Temple & Bulk Samosa Orders NJ NY CT",
  "body": "<style>\n  .TitleHeading{display:none!important}\n  .qs-catering{font-family:Arial,sans-serif;color:#361018;max-width:1180px;margin:0 auto;padding:18px 14px 42px;line-height:1.65;box-sizing:border-box}\n  .qs-catering *{box-sizing:border-box}\n  .qs-catering h1,.qs-catering h2,.qs-catering h3{font-family:Georgia,serif;color:#701326;line-height:1.24}\n  .qs-catering h1{font-size:clamp(28px,4vw,44px);margin:8px 0 14px}\n  .qs-catering h2{font-size:clamp(22px,3vw,32px);margin:0 0 14px}\n  .qs-catering h3{font-size:20px;margin:0 0 8px}\n  .qs-catering p{font-size:16px}\n  .qs-hero{background:linear-gradient(135deg,#4b0714,#87182d);border:2px solid #d7b35a;border-radius:14px;color:#fff;padding:clamp(28px,5vw,54px);text-align:center}\n  .qs-hero h1{color:#fff}\n  .qs-hero p{color:#ffefd5;max-width:860px;margin:0 auto 22px;font-size:17px}\n  .qs-kicker{color:#ffd878;font-size:13px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase}\n  .qs-notice{background:#fff5dc;border:2px solid #d7b35a;border-radius:10px;color:#48101a;max-width:920px;margin:24px auto;padding:15px 18px;font-weight:700;text-align:center}\n  .qs-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}\n  .qs-btn{background:#fff;color:#701326!important;border-radius:6px;display:inline-block;font-weight:700;padding:12px 20px;text-decoration:none;border:none;cursor:pointer;font-size:15px}\n  .qs-btn--gold{background:#d7b35a;color:#3b0b14!important}\n  .qs-btn--gold:hover{background:#e5c26b}\n  .qs-section{margin-top:30px;padding:28px;background:#fffdf9;border:1px solid #eadfcb;border-radius:12px;box-shadow:0 3px 14px rgba(58,17,24,.06)}\n  .qs-grid-2{display:grid;gap:22px;grid-template-columns:repeat(2,minmax(0,1fr))}\n  .qs-grid-4{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}\n  .qs-card{background:#fff;border:1px solid #e7d8c3;border-radius:10px;padding:22px;transition:transform .2s ease,box-shadow .2s ease}\n  .qs-card:hover{transform:translateY(-3px);box-shadow:0 6px 18px rgba(75,7,20,.1)}\n  .qs-card-icon{font-size:32px;margin-bottom:10px}\n  .qs-card h3{color:#701326}\n  .qs-card p{color:#4a383a;font-size:15px;margin:0 0 14px}\n  .qs-card-link{color:#701326;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:4px}\n  .qs-card-link:hover{text-decoration:underline}\n  .qs-tasting-box{background:linear-gradient(135deg,#fff8eb,#ffeed3);border:2px dashed #d7b35a;border-radius:12px;padding:26px;margin:28px 0;text-align:center}\n  .qs-tasting-box h2{color:#701326;margin-top:0}\n  .qs-tasting-badge{display:inline-block;background:#701326;color:#ffd878;font-weight:700;padding:4px 12px;border-radius:20px;font-size:13px;margin-bottom:12px}\n  .qs-form-group{margin-bottom:16px}\n  .qs-form-group label{display:block;font-weight:700;color:#50131e;margin-bottom:6px;font-size:14px}\n  .qs-form-group input,.qs-form-group select,.qs-form-group textarea{width:100%;padding:11px 14px;border:1px solid #c9b49b;border-radius:6px;font-size:15px;font-family:inherit;background:#fff}\n  .qs-form-group input:focus,.qs-form-group select:focus,.qs-form-group textarea:focus{outline:none;border-color:#701326;box-shadow:0 0 0 3px rgba(112,19,38,.12)}\n  .qs-checkbox-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;background:#fff;padding:12px;border:1px solid #c9b49b;border-radius:6px}\n  .qs-checkbox-label{display:flex;align-items:center;gap:8px;font-weight:400;font-size:14px;cursor:pointer}\n  .qs-checkbox-label input{width:auto}\n  .qs-trust-bar{display:flex;justify-content:space-around;flex-wrap:wrap;gap:16px;background:#fbf5e9;padding:18px;border-radius:10px;margin-top:20px;text-align:center}\n  .qs-trust-item{font-weight:700;color:#701326;font-size:15px}\n  .qs-faq details{border-top:1px solid #eadfcb;padding:14px 0}\n  .qs-faq summary{color:#701326;cursor:pointer;font-family:Georgia,serif;font-size:18px;font-weight:700}\n  @media(max-width:768px){.qs-grid-2{grid-template-columns:1fr}.qs-section{padding:20px 16px}}\n</style>\n\n<main class=\"qs-catering\">\n  <section class=\"qs-hero\">\n    <div class=\"qs-kicker\">Tri-State Catering &amp; Bulk Orders &bull; NJ &bull; NY &bull; CT &bull; Since 2003</div>\n    <h1>Authentic Indian Catering &amp; Bulk Orders Across NJ, NY, and CT</h1>\n    <p>Serving Indian Weddings, Hindu Mandirs, Corporate Celebrations, and Family Gatherings with 100% Pure Vegetarian Freshness, Zero Chemical Preservatives, and Handcrafted Perfection.</p>\n    <div class=\"qs-actions\">\n      <a class=\"qs-btn qs-btn--gold\" href=\"#quote-form\">Request a B2B Catering Quote</a>\n      <a class=\"qs-btn\" href=\"https://wa.me/17328037617\" target=\"_blank\" rel=\"noopener\">WhatsApp Us: (732) 803-7617</a>\n    </div>\n  </section>\n\n  <div class=\"qs-notice\">\n    <strong>100% PURE VEGETARIAN &bull; ZERO PRESERVATIVES &bull; MADE FRESH DAILY IN NEW JERSEY</strong><br>\n    From gold luxury mithai gift boxes to live crispy jalebi stations and hot samosa platters, we deliver artisanal Indian sweets and savory catering for gatherings of 50 to 5,000+ guests.\n  </div>\n\n  <section class=\"qs-section\">\n    <h2>Our 4 Core B2B Catering &amp; Bulk Services</h2>\n    <div class=\"qs-grid-4\">\n      <article class=\"qs-card\">\n        <div class=\"qs-card-icon\">?</div>\n        <h3>Wedding Sweets &amp; Favors</h3>\n        <p>Custom golden Ganesh &amp; Peacock return gift boxes, opulent mithai dessert tables, and live jalebi stations for weddings in NJ, NYC, Long Island &amp; CT.</p>\n        <a class=\"qs-card-link\" href=\"/catering/wedding-catering-tri-state/\">Explore Wedding Services &rarr;</a>\n      </article>\n\n      <article class=\"qs-card\">\n        <div class=\"qs-card-icon\">?</div>\n        <h3>Temple &amp; Mandir Bulk Prasad</h3>\n        <p>Direct wholesale rates for Mandirs. Pure Motichur Ladoo, Besan Ladoo, Kesar Peda &amp; Mahaprasad sweets by the 100s of pounds. Always 100% pure veg.</p>\n        <a class=\"qs-card-link\" href=\"/catering/temple-mandir-bulk-prasad/\">Explore Temple Bulk Prasad &rarr;</a>\n      </article>\n\n      <article class=\"qs-card\">\n        <div class=\"qs-card-icon\">?</div>\n        <h3>Bulk Samosa Platters</h3>\n        <p>50 to 1,000+ hot, handcrafted samosas (never frozen) packed in heavy-duty aluminum catering trays with sweet tamarind and spicy mint chutneys.</p>\n        <a class=\"qs-card-link\" href=\"/catering/bulk-samosa-orders/\">Order Bulk Samosas &rarr;</a>\n      </article>\n\n      <article class=\"qs-card\">\n        <div class=\"qs-card-icon\">?</div>\n        <h3>Corporate &amp; Event Gifting</h3>\n        <p>Branded luxury mithai gift baskets and assorted boxes for corporate clients, Diwali gifting, and executive celebrations in Manhattan &amp; NJ.</p>\n        <a class=\"qs-card-link\" href=\"#quote-form\">Inquire for Corporate Gifting &rarr;</a>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"qs-tasting-box\">\n    <span class=\"qs-tasting-badge\">WEDDING &amp; EVENT SPECIAL OFFER</span>\n    <h2>Planning an Event? Try The Quality Sweets Tasting Box for $29</h2>\n    <p>Receive a curated sampler box featuring 6 of our signature luxury mithai (including Kaju Katli, Chum Chum, and Motichur Ladoo) plus sample gold gift boxes delivered directly to your home in New Jersey, New York, or Connecticut.</p>\n    <p><strong>Bonus Guarantee:</strong> Book your event catering with Quality Sweets and the full $29 will be credited directly to your final catering invoice!</p>\n    <a class=\"qs-btn qs-btn--gold\" href=\"https://wa.me/17328037617?text=Hi%20Quality%20Sweets%2C%20I%20would%20like%20to%20order%20the%20%2429%20Wedding%20Tasting%20Box\" target=\"_blank\" rel=\"noopener\">Order Your $29 Tasting Box via WhatsApp</a>\n  </section>\n\n  <section class=\"qs-section\" id=\"quote-form\">\n    <h2>Request a Catering &amp; Wholesale Quote</h2>\n    <p>Complete the inquiry form below and our B2B catering manager will contact you within 4 business hours with a custom quote.</p>\n    \n    <form id=\"b2b-catering-form\" onsubmit=\"event.preventDefault(); handleCateringSubmit();\">\n      <div class=\"qs-grid-2\">\n        <div class=\"qs-form-group\">\n          <label for=\"event-type\">Event Type *</label>\n          <select id=\"event-type\" required>\n            <option value=\"\">-- Select Event Type --</option>\n            <option value=\"Wedding / Engagement\">Wedding / Engagement / Reception</option>\n            <option value=\"Temple / Mandir Puja\">Temple / Mandir Puja / Religious Festival</option>\n            <option value=\"Private Party / Bulk Samosas\">Private Party / Bulk Samosas &amp; Chaat</option>\n            <option value=\"Corporate Gifting\">Corporate Gifting / Executive Event</option>\n            <option value=\"Other Bulk Order\">Other Bulk Order</option>\n          </select>\n        </div>\n\n        <div class=\"qs-form-group\">\n          <label for=\"event-date\">Event Date *</label>\n          <input type=\"date\" id=\"event-date\" required>\n        </div>\n      </div>\n\n      <div class=\"qs-grid-2\">\n        <div class=\"qs-form-group\">\n          <label for=\"guest-count\">Estimated Guest Count / Samosa Quantity *</label>\n          <input type=\"text\" id=\"guest-count\" placeholder=\"e.g. 250 guests or 300 samosas\" required>\n        </div>\n\n        <div class=\"qs-form-group\">\n          <label for=\"event-location\">Event City &amp; State *</label>\n          <input type=\"text\" id=\"event-location\" placeholder=\"e.g. Edison NJ, NYC, Stamford CT\" required>\n        </div>\n      </div>\n\n      <div class=\"qs-form-group\">\n        <label>Services &amp; Items Required (Check all that apply)</label>\n        <div class=\"qs-checkbox-grid\">\n          <label class=\"qs-checkbox-label\"><input type=\"checkbox\" name=\"service\" value=\"Custom Mithai Gift Boxes\"> Custom Mithai Gift Boxes</label>\n          <label class=\"qs-checkbox-label\"><input type=\"checkbox\" name=\"service\" value=\"Live Jalebi Station\"> Live Jalebi Station</label>\n          <label class=\"qs-checkbox-label\"><input type=\"checkbox\" name=\"service\" value=\"Hot Samosa Platters\"> Hot Samosa Platters</label>\n          <label class=\"qs-checkbox-label\"><input type=\"checkbox\" name=\"service\" value=\"Temple Prasad (Ladoos/Pedas)\"> Temple Prasad (Ladoos/Pedas)</label>\n          <label class=\"qs-checkbox-label\"><input type=\"checkbox\" name=\"service\" value=\"Mithai Dessert Table Display\"> Mithai Dessert Table Display</label>\n          <label class=\"qs-checkbox-label\"><input type=\"checkbox\" name=\"service\" value=\"Chaat & Street Food Platters\"> Chaat &amp; Street Food Platters</label>\n        </div>\n      </div>\n\n      <div class=\"qs-grid-2\">\n        <div class=\"qs-form-group\">\n          <label for=\"contact-name\">Your Full Name *</label>\n          <input type=\"text\" id=\"contact-name\" placeholder=\"Full Name\" required>\n        </div>\n\n        <div class=\"qs-form-group\">\n          <label for=\"contact-phone\">Phone Number / WhatsApp *</label>\n          <input type=\"tel\" id=\"contact-phone\" placeholder=\"(732) 000-0000\" required>\n        </div>\n      </div>\n\n      <div class=\"qs-form-group\">\n        <label for=\"contact-email\">Email Address *</label>\n        <input type=\"email\" id=\"contact-email\" placeholder=\"email@example.com\" required>\n      </div>\n\n      <div class=\"qs-form-group\">\n        <label for=\"contact-notes\">Special Instructions or Custom Requirements</label>\n        <textarea id=\"contact-notes\" rows=\"4\" placeholder=\"Tell us more about your dietary requirements, custom box design ideas, or specific mithai preferences...\"></textarea>\n      </div>\n\n      <div style=\"text-align:center;margin-top:20px\">\n        <button type=\"submit\" class=\"qs-btn qs-btn--gold\" style=\"padding:14px 32px;font-size:17px\">Submit B2B Catering Inquiry</button>\n      </div>\n    </form>\n\n    <div id=\"form-success-msg\" style=\"display:none;background:#e7f7ed;border:2px solid #2e7d32;color:#1b5e20;padding:20px;border-radius:10px;margin-top:20px;text-align:center\">\n      <h3>Thank You! Your Catering Inquiry Has Been Received.</h3>\n      <p>Our catering specialist will review your details and reach out within 4 business hours.</p>\n      <p>Need an urgent response? Message us directly on WhatsApp: <a href=\"https://wa.me/17328037617\" target=\"_blank\" rel=\"noopener\" style=\"color:#1b5e20;font-weight:bold\">(732) 803-7617</a>.</p>\n    </div>\n  </section>\n\n  <div class=\"qs-trust-bar\">\n    <div class=\"qs-trust-item\">? 100% Pure Vegetarian</div>\n    <div class=\"qs-trust-item\">? Zero Chemical Preservatives</div>\n    <div class=\"qs-trust-item\">? Handcrafted Daily in NJ</div>\n    <div class=\"qs-trust-item\">? Over 20 Years Experience (Since 2003)</div>\n  </div>\n\n  <section class=\"qs-section qs-faq\">\n    <h2>Frequently Asked Questions About Our Catering</h2>\n    <details>\n      <summary>What regions do you cover for B2B catering and delivery?</summary>\n      <p>We provide bulk orders, party platters, and catering services across all of New Jersey (Middlesex, Bergen, Hudson, Somerset), New York (Manhattan, Queens, Brooklyn, Long Island, Westchester), and Connecticut (Stamford, Greenwich).</p>\n    </details>\n    <details>\n      <summary>Are your sweets and food 100% vegetarian?</summary>\n      <p>Yes. Quality Sweets operates a 100% strict vegetarian facility. We use pure milk, fresh chhena, pure ghee, premium nuts, and natural spices with zero animal lard or gelatin.</p>\n    </details>\n    <details>\n      <summary>How far in advance should I place a bulk order or wedding catering request?</summary>\n      <p>For large weddings or live station events, we recommend booking 2 to 4 weeks in advance. For bulk samosas (50–500 pieces) or temple prasad orders, 24 to 48 hours notice is sufficient.</p>\n    </details>\n    <details>\n      <summary>Can I order custom-branded or personalized mithai gift boxes?</summary>\n      <p>Absolutely. We offer custom gold Ganesh boxes, peacock boxes, and custom branded sleeves for corporate Diwali gifts or wedding return gifts.</p>\n    </details>\n  </section>\n</main>\n\n<script>\n  function handleCateringSubmit() {\n    var name = document.getElementById('contact-name').value;\n    var phone = document.getElementById('contact-phone').value;\n    var eventType = document.getElementById('event-type').value;\n    var eventDate = document.getElementById('event-date').value;\n    var guestCount = document.getElementById('guest-count').value;\n    var location = document.getElementById('event-location').value;\n    \n    var services = [];\n    document.querySelectorAll('input[name=\"service\"]:checked').forEach(function(cb) {\n      services.push(cb.value);\n    });\n\n    var message = \"Hi Quality Sweets! Catering Request:\\n\" +\n      \"- Name: \" + name + \"\\n\" +\n      \"- Phone: \" + phone + \"\\n\" +\n      \"- Event: \" + eventType + \" on \" + eventDate + \"\\n\" +\n      \"- Guests/Qty: \" + guestCount + \"\\n\" +\n      \"- Location: \" + location + \"\\n\" +\n      \"- Services: \" + (services.length > 0 ? services.join(\", \") : \"General Inquiry\");\n\n    document.getElementById('b2b-catering-form').style.display = 'none';\n    document.getElementById('form-success-msg').style.display = 'block';\n\n    var waUrl = \"https://wa.me/17328037617?text=\" + encodeURIComponent(message);\n    window.open(waUrl, '_blank');\n  }\n\n  (function () {\n    Array.prototype.slice.call(document.querySelectorAll('h2')).forEach(function (heading) {\n      if (heading.textContent.trim().toLowerCase() === 'categories') {\n        var div = document.createElement('div');\n        for (var i = 0; i < heading.attributes.length; i++) {\n          div.setAttribute(heading.attributes[i].name, heading.attributes[i].value);\n        }\n        div.className += ' qs-nonheading-label';\n        div.innerHTML = heading.innerHTML;\n        heading.parentNode.replaceChild(div, heading);\n      }\n    });\n  }());\n</script>\n",
